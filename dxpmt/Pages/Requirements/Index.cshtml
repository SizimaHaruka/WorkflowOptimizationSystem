@page
@model dxpmt.Pages.Requirements.IndexModel
@{ViewData["Title"]="F08 要求事項一覧";}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F08</p><h1>要求事項一覧</h1><p class="text-muted mb-0">To-Be作業から実現すべき要件と受入条件を整理します。</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.CaseId">案件詳細</a><a class="btn btn-primary" asp-page="Create" asp-route-caseId="@Model.CaseId">要求事項を追加</a></div></div>
@if(!Model.Items.Any()){<div class="empty-state">要求事項はまだ登録されていません。</div>}else{<div class="table-responsive form-card p-0"><table class="table table-hover mb-0"><thead><tr><th>No.</th><th>要求事項</th><th>To-Be作業</th><th>優先度</th><th>状態</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Sequence</td><td><strong>@item.Title</strong><br/><small class="text-muted">@item.Description</small></td><td>@(item.WorkItem?.Name??"未紐付け")</td><td>@item.Priority</td><td>@item.Status</td></tr>}</tbody></table></div>}
