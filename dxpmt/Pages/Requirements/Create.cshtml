@page
@model dxpmt.Pages.Requirements.CreateModel
@{ViewData["Title"]="F08 要求事項を追加";}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F08</p><h1>要求事項を追加</h1></div><a class="btn btn-outline-secondary" asp-page="Index" asp-route-caseId="@Model.Case.Id">一覧へ戻る</a></div><form method="post" class="form-card"><input type="hidden" name="caseId" value="@Model.Case.Id"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Input.WorkItemId" class="form-label"></label><select asp-for="Input.WorkItemId" class="form-select"><option value="">未紐付け</option>@foreach(var x in Model.WorkItems){<option value="@x.Id">@x.Sequence. @x.Name</option>}</select></div><div class="col-md-3"><label asp-for="Input.Category" class="form-label"></label><select asp-for="Input.Category" class="form-select">@foreach(var x in dxpmt.Domain.RequirementCategories.All){<option>@x</option>}</select></div><div class="col-md-3"><label asp-for="Input.Priority" class="form-label"></label><select asp-for="Input.Priority" class="form-select">@foreach(var x in dxpmt.Domain.CasePriorities.All){<option>@x</option>}</select></div><div class="col-12"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control"/><span asp-validation-for="Input.Title" class="text-danger"></span></div><div class="col-12"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.AcceptanceCriteria" class="form-label"></label><textarea asp-for="Input.AcceptanceCriteria" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.ImplementationApproach" class="form-label"></label><textarea asp-for="Input.ImplementationApproach" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.Status" class="form-label"></label><select asp-for="Input.Status" class="form-select">@foreach(var x in dxpmt.Domain.RequirementStatuses.All){<option>@x</option>}</select></div></div><div class="form-actions"><button class="btn btn-primary">保存</button></div></form>
