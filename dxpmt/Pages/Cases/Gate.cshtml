@page
@model dxpmt.Pages.Cases.GateModel
@{
    ViewData["Title"] = Model.GateName;
}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / @Model.Gate</p><h1>@Model.GateName</h1><p class="text-muted mb-0">完了条件、判断者、判断日、コメントを記録します。</p></div><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.Case.Id">案件詳細へ戻る</a></div>
<form method="post" class="form-card"><input type="hidden" name="caseId" value="@Model.Case.Id" /><input type="hidden" name="gate" value="@Model.Gate" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <section class="form-section"><h2>完了条件</h2><p class="text-muted small">承認する場合は、すべての項目を確認してください。差戻しの場合は未完了項目を残したまま記録できます。</p><div class="checklist">
        @if (Model.Gate == Gates.G0)
        {
            <label><input asp-for="Input.ProblemIsClear" class="form-check-input" /> 問題が明確である</label>
            <label><input asp-for="Input.RequesterIsClear" class="form-check-input" /> 依頼者が明確である</label>
            <label><input asp-for="Input.OwnerIsClear" class="form-check-input" /> 案件責任者が明確である</label>
            <label><input asp-for="Input.ScopeIsClear" class="form-check-input" /> 概略範囲が明確である</label>
        }
        else if (Model.Gate == Gates.G1)
        {
            <label><input asp-for="Input.StartEventIsClear" class="form-check-input" /> 開始点が合意済みである</label>
            <label><input asp-for="Input.EndStateIsClear" class="form-check-input" /> 終了点・成果物が合意済みである</label>
            <label><input asp-for="Input.TargetDepartmentsAreAgreed" class="form-check-input" /> 対象部署が合意済みである</label>
            <label><input asp-for="Input.ExcludedScopeIsAgreed" class="form-check-input" /> 除外範囲が合意済みである</label>
        }
        else
        {
            <label><input asp-for="Input.WorkItemsAreConfirmed" class="form-check-input" /> 通常作業と主要作業が対象者により確認済みである</label>
            <label><input asp-for="Input.FlowIsConnected" class="form-check-input" /> 開始から終了までのフローがつながっている</label>
            <label><input asp-for="Input.InputsOutputsAreConfirmed" class="form-check-input" /> 入出力と前後関係が確認済みである</label>
            <label><input asp-for="Input.JudgementsAreConfirmed" class="form-check-input" /> 主要な判断・確認が記録済みである</label>
            <label><input asp-for="Input.ExceptionsAreIncluded" class="form-check-input" /> 主要な例外・差戻しが記録済みである</label>
        }
    </div></section>
    <section class="form-section"><h2>判定</h2><div class="row g-3"><div class="col-md-4"><label asp-for="Input.Decision" class="form-label"></label><select asp-for="Input.Decision" class="form-select"><option value="承認">承認</option><option value="差戻し">差戻し</option></select></div><div class="col-md-4"><label asp-for="Input.ReviewerName" class="form-label"></label><input asp-for="Input.ReviewerName" class="form-control" /><span asp-validation-for="Input.ReviewerName" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.ReviewedOn" class="form-label"></label><input asp-for="Input.ReviewedOn" class="form-control" type="date" /></div><div class="col-12"><label asp-for="Input.Comment" class="form-label"></label><textarea asp-for="Input.Comment" class="form-control" rows="4" placeholder="差戻し理由、判断の前提、次に確認することを記録します。"></textarea></div></div></section>
    <div class="form-actions"><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.Case.Id">キャンセル</a><button class="btn btn-primary" type="submit">判定を記録</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
