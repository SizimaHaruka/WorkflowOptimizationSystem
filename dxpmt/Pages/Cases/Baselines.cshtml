@page
@model dxpmt.Pages.Cases.BaselinesModel
@{ ViewData["Title"] = "基準版履歴"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber</p><h1>基準版履歴</h1><p class="text-muted mb-0">ゲート承認時に確定した成果物です。通常保存や差戻しでは増えません。</p></div><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.Case.Id">案件詳細へ戻る</a></div>
<section class="panel"><div class="panel-heading"><h2>確定済み基準版</h2></div>@if(!Model.Items.Any()){<p class="empty-state">まだ基準版はありません。</p>}else{<div class="table-responsive"><table class="table app-table align-middle mb-0"><thead><tr><th>帳票</th><th>版</th><th>確定ゲート</th><th>確定者</th><th>確定日時</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.FormType</td><td>第@(item.Version)版</td><td>@dxpmt.Domain.Gates.GetName(item.Gate)</td><td>@item.ConfirmedBy</td><td>@item.ConfirmedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td><details><summary>内容</summary><pre class="version-content">@item.ContentJson</pre></details></td></tr>}</tbody></table></div>}</section>
