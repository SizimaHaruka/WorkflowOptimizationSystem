@page
@model dxpmt.Pages.Cases.CreateModel
@{
    ViewData["Title"] = "案件登録";
}

<div class="page-heading mb-4">
    <p class="eyebrow">NEW CASE</p>
    <h1>案件を登録</h1>
    <p class="text-muted mb-0">まず案件台帳を作成し、続けて F01 案件受付票に困りごとと対象範囲を記録します。</p>
</div>

<form method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" autofocus />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Priority" class="form-label"></label>
            <select asp-for="Input.Priority" class="form-select">
                @foreach (var priority in Model.Priorities)
                {
                    <option value="@priority">@priority</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.RequestingDepartment" class="form-label"></label>
            <input asp-for="Input.RequestingDepartment" class="form-control" />
            <span asp-validation-for="Input.RequestingDepartment" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.RequesterName" class="form-label"></label>
            <input asp-for="Input.RequesterName" class="form-control" />
            <span asp-validation-for="Input.RequesterName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.OwnerName" class="form-label"></label>
            <input asp-for="Input.OwnerName" class="form-control" />
            <span asp-validation-for="Input.OwnerName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.RegisteredOn" class="form-label"></label>
            <input asp-for="Input.RegisteredOn" class="form-control" type="date" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.DesiredBy" class="form-label"></label>
            <input asp-for="Input.DesiredBy" class="form-control" type="date" />
        </div>
        <div class="col-12">
            <label asp-for="Input.ScopeSummary" class="form-label"></label>
            <textarea asp-for="Input.ScopeSummary" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.ScopeSummary" class="text-danger"></span>
        </div>
    </div>
    <div class="form-actions">
        <a class="btn btn-outline-secondary" asp-page="/Cases/Index">キャンセル</a>
        <button class="btn btn-primary" type="submit">案件を登録して F01 へ</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
