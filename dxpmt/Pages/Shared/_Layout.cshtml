<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 合理化検討</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dxpmt.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">合理化検討</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="メニューを開く">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">要対応</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Cases/Index">案件</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/ActionItems/Index">課題・宿題</a></li>
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text">@User.Identity.Name</span>
                        <form method="post" asp-page="/Auth/Logout" class="d-inline"><button class="btn btn-outline-light btn-sm ms-2">ログアウト</button></form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main class="container py-4" role="main">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">&copy; 2026 合理化検討ワークフロー</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
