@page "{id:int}"
@model dxpmt.Pages.ToBeWorkItems.EditModel
@{ ViewData["Title"]="F07 To-Be作業を編集"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">F07-@Model.Item.Sequence</p><h1>To-Be作業を編集</h1></div><a class="btn btn-outline-secondary" asp-page="Index" asp-route-caseId="@Model.Item.CaseId">一覧へ戻る</a></div><form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Input.ImprovementOptionId" class="form-label"></label><select asp-for="Input.ImprovementOptionId" class="form-select"><option value="">未紐付け</option>@foreach(var option in Model.ImprovementOptions){<option value="@option.Id">@option.Sequence. @option.Title</option>}</select></div><div class="col-md-6"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.BusinessProcessName" class="form-label"></label><input asp-for="Input.BusinessProcessName" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.DepartmentAndRole" class="form-label"></label><input asp-for="Input.DepartmentAndRole" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.Performer" class="form-label"></label><input asp-for="Input.Performer" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.StartTrigger" class="form-label"></label><textarea asp-for="Input.StartTrigger" class="form-control" rows="2"></textarea></div><div class="col-md-6"><label asp-for="Input.CompletionCondition" class="form-label"></label><textarea asp-for="Input.CompletionCondition" class="form-control" rows="2"></textarea></div><div class="col-md-6"><label asp-for="Input.Purpose" class="form-label"></label><textarea asp-for="Input.Purpose" class="form-control" rows="2"></textarea></div><div class="col-md-6"><label asp-for="Input.Handover" class="form-label"></label><textarea asp-for="Input.Handover" class="form-control" rows="2"></textarea></div><div class="col-12"><label asp-for="Input.Exceptions" class="form-label"></label><textarea asp-for="Input.Exceptions" class="form-control" rows="2"></textarea></div><div class="col-12 form-check"><input asp-for="Input.IsConfirmed" class="form-check-input"/><label asp-for="Input.IsConfirmed" class="form-check-label"></label></div></div><div class="form-actions"><a class="btn btn-outline-secondary" asp-page="Index" asp-route-caseId="@Model.Item.CaseId">キャンセル</a><button class="btn btn-primary" type="submit">更新</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
