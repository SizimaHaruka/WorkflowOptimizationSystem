@page
@model dxpmt.Pages.ToBeWorkItems.IndexModel
@{ ViewData["Title"] = "F07 To-Be作業定義票"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F07</p><h1>To-Be作業定義票</h1><p class="text-muted mb-0">改善後の作業、役割、引渡し条件を定義します。</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.CaseId">案件詳細</a><a class="btn btn-primary" asp-page="Create" asp-route-caseId="@Model.CaseId">To-Be作業を追加</a></div></div>
@if (!Model.Items.Any()) { <div class="empty-state"><p class="mb-2">To-Be作業はまだ登録されていません。</p><a class="btn btn-primary" asp-page="Create" asp-route-caseId="@Model.CaseId">最初の作業を定義</a></div> } else { <div class="table-responsive form-card p-0"><table class="table table-hover mb-0"><thead><tr><th>No.</th><th>作業名</th><th>担当部署・役割</th><th>実施者</th><th>確認</th><th></th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.Sequence</td><td><strong>@item.Name</strong><br/><small class="text-muted">@item.BusinessProcessName</small></td><td>@item.DepartmentAndRole</td><td>@item.Performer</td><td>@(item.IsConfirmed ? "済" : "未")</td><td><a class="btn btn-outline-primary btn-sm" asp-page="Edit" asp-route-id="@item.Id">編集</a></td></tr> }</tbody></table></div> }
