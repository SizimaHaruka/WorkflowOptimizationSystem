@page
@model dxpmt.Pages.ToBeWorkItems.CreateModel
@{ ViewData["Title"] = "F07 To-Be作業を追加"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F07</p><h1>To-Be作業を追加</h1><p class="text-muted mb-0">改善案との関係を記録して、後続の要求事項へつなげます。</p></div><a class="btn btn-outline-secondary" asp-page="Index" asp-route-caseId="@Model.Case.Id">一覧へ戻る</a></div>
<form method="post" class="form-card"><input type="hidden" name="caseId" value="@Model.Case.Id"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Input.ImprovementOptionId" class="form-label"></label><select asp-for="Input.ImprovementOptionId" class="form-select"><option value="">未紐付け</option>@foreach(var option in Model.ImprovementOptions){<option value="@option.Id">@option.Sequence. @option.Title</option>}</select></div><div class="col-md-6"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control"/><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.BusinessProcessName" class="form-label"></label><input asp-for="Input.BusinessProcessName" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.DepartmentAndRole" class="form-label"></label><input asp-for="Input.DepartmentAndRole" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.Performer" class="form-label"></label><input asp-for="Input.Performer" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.StartTrigger" class="form-label"></label><textarea asp-for="Input.StartTrigger" class="form-control" rows="2"></textarea></div><div class="col-md-6"><label asp-for="Input.CompletionCondition" class="form-label"></label><textarea asp-for="Input.CompletionCondition" class="form-control" rows="2"></textarea></div><div class="col-md-6"><label asp-for="Input.Purpose" class="form-label"></label><textarea asp-for="Input.Purpose" class="form-control" rows="2"></textarea></div><div class="col-md-6"><label asp-for="Input.Handover" class="form-label"></label><textarea asp-for="Input.Handover" class="form-control" rows="2"></textarea></div><div class="col-12"><label asp-for="Input.Exceptions" class="form-label"></label><textarea asp-for="Input.Exceptions" class="form-control" rows="2"></textarea></div><div class="col-12 form-check"><input asp-for="Input.IsConfirmed" class="form-check-input"/><label asp-for="Input.IsConfirmed" class="form-check-label"></label></div></div><div class="form-actions"><a class="btn btn-outline-secondary" asp-page="Index" asp-route-caseId="@Model.Case.Id">キャンセル</a><button class="btn btn-primary">保存</button></div></form>
