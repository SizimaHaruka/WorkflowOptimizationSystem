@page
@model dxpmt.Pages.Forms.F04Model
@{ViewData["Title"]="F04 業務フロー整理票";}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F04</p><h1>業務フロー整理票</h1><p class="text-muted mb-0">F03の作業を時系列に確認し、As-Isの境界と例外を整理します。</p></div><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.Case.Id">案件詳細へ戻る</a></div><form method="post" class="form-card"><input type="hidden" name="caseId" value="@Model.Case.Id"/><section class="form-section"><h2>基本情報</h2><div class="row g-3"><div class="col-md-6"><label asp-for="Input.FlowName" class="form-label">フロー名</label><input asp-for="Input.FlowName" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.Scope" class="form-label">対象範囲</label><input asp-for="Input.Scope" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.Author" class="form-label">作成者</label><input asp-for="Input.Author" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.Reviewer" class="form-label">確認者</label><input asp-for="Input.Reviewer" class="form-control"/></div></div></section><section class="form-section"><h2>作業一覧（F03から参照）</h2><div class="table-responsive"><table class="table app-table"><thead><tr><th>No.</th><th>担当部署・役割</th><th>作業名</th><th>確認</th></tr></thead><tbody>@foreach(var x in Model.WorkItems){<tr><td>@x.Sequence</td><td>@x.DepartmentAndRole</td><td>@x.Name</td><td>@(x.IsConfirmed?"済":"未")</td></tr>}</tbody></table></div></section><section class="form-section"><h2>主要な判断・例外</h2><div class="row g-3"><div class="col-md-6"><label asp-for="Input.KeyJudgements" class="form-label">主要な判断・分岐</label><textarea asp-for="Input.KeyJudgements" class="form-control" rows="4"></textarea></div><div class="col-md-6"><label asp-for="Input.KeyExceptions" class="form-label">主要な例外・差戻し</label><textarea asp-for="Input.KeyExceptions" class="form-control" rows="4"></textarea></div></div></section><section class="form-section"><h2>レビュー</h2><div class="checklist"><label><input asp-for="Input.IsConnectedEndToEnd" class="form-check-input"/>開始から終了までつながっている</label><label><input asp-for="Input.AreDepartmentsClear" class="form-check-input"/>担当部署が明確</label><label><input asp-for="Input.AreInputsOutputsConnected" class="form-check-input"/>入出力がつながっている</label><label><input asp-for="Input.AreJudgementCriteriaConfirmed" class="form-check-input"/>判断基準が確認されている</label><label><input asp-for="Input.AreExceptionsIncluded" class="form-check-input"/>主要例外が含まれている</label><label><input asp-for="Input.IsSeparatedFromToBe" class="form-check-input"/>現状と改善案が混在していない</label></div></section><div class="form-actions"><button class="btn btn-primary">F04を保存</button></div></form>
