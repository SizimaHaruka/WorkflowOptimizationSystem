@page
@model dxpmt.Pages.Forms.F09Model
@{ViewData["Title"]="F09 効果確認票";}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F09</p><h1>効果確認票</h1><p class="text-muted mb-0">改善後の効果、残課題、標準化とフォローアップを記録します。</p></div><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.Case.Id">案件詳細へ戻る</a></div>
<form method="post" class="form-card"><input type="hidden" name="caseId" value="@Model.Case.Id"/><div class="row g-3"><div class="col-md-4"><label asp-for="Input.MeasurementStartOn" class="form-label">測定開始日</label><input asp-for="Input.MeasurementStartOn" class="form-control" type="date"/></div><div class="col-md-4"><label asp-for="Input.MeasurementEndOn" class="form-label">測定終了日</label><input asp-for="Input.MeasurementEndOn" class="form-control" type="date"/></div><div class="col-md-4"><label asp-for="Input.Owner" class="form-label">責任者</label><input asp-for="Input.Owner" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.Baseline" class="form-label">改善前の基準値</label><textarea asp-for="Input.Baseline" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.TargetEffect" class="form-label">目標効果</label><textarea asp-for="Input.TargetEffect" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.ActualEffect" class="form-label">実績効果</label><textarea asp-for="Input.ActualEffect" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.MeasurementMethod" class="form-label">測定方法・根拠</label><textarea asp-for="Input.MeasurementMethod" class="form-control" rows="3"></textarea></div><div class="col-12"><label asp-for="Input.DifferenceAnalysis" class="form-label">差異の分析</label><textarea asp-for="Input.DifferenceAnalysis" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.RemainingIssues" class="form-label">残課題</label><textarea asp-for="Input.RemainingIssues" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.StandardizationPlan" class="form-label">標準化・横展開</label><textarea asp-for="Input.StandardizationPlan" class="form-control" rows="3"></textarea></div><div class="col-12"><label asp-for="Input.FollowUpPlan" class="form-label">フォローアップ計画</label><textarea asp-for="Input.FollowUpPlan" class="form-control" rows="3"></textarea></div></div><div class="form-actions"><button class="btn btn-primary">保存</button></div></form>
