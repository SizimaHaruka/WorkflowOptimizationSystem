@page "{id:int}"
@model dxpmt.Pages.Problems.EditModel
@{ViewData["Title"]="問題を編集";}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">F05-@Model.Item.Sequence</p><h1>問題を編集</h1></div><a class="btn btn-outline-secondary" asp-page="Index" asp-route-caseId="@Model.Item.CaseId">一覧へ戻る</a></div><form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Input.WorkItemId" class="form-label"></label><select asp-for="Input.WorkItemId" class="form-select"><option value="">未紐付け</option>@foreach(var x in Model.WorkItems){<option value="@x.Id">@x.Sequence. @x.Name</option>}</select></div><div class="col-md-3"><label asp-for="Input.Category" class="form-label"></label><select asp-for="Input.Category" class="form-select">@foreach(var x in Model.Categories){<option value="@x">@x</option>}</select></div><div class="col-md-3"><label asp-for="Input.Severity" class="form-label"></label><select asp-for="Input.Severity" class="form-select"><option>高</option><option>中</option><option>低</option></select></div><div class="col-12"><label asp-for="Input.Phenomenon" class="form-label"></label><textarea asp-for="Input.Phenomenon" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.OccurrenceCondition" class="form-label"></label><textarea asp-for="Input.OccurrenceCondition" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.Impact" class="form-label"></label><textarea asp-for="Input.Impact" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.CurrentWorkaround" class="form-label"></label><textarea asp-for="Input.CurrentWorkaround" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.CauseHypothesis" class="form-label"></label><textarea asp-for="Input.CauseHypothesis" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.Evidence" class="form-label"></label><textarea asp-for="Input.Evidence" class="form-control" rows="3"></textarea></div><div class="col-md-3"><label asp-for="Input.Status" class="form-label"></label><select asp-for="Input.Status" class="form-select"><option>確認中</option><option>確定</option></select></div></div><div class="form-actions"><a class="btn btn-outline-secondary" asp-page="Index" asp-route-caseId="@Model.Item.CaseId">キャンセル</a><button class="btn btn-primary" type="submit">更新</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
