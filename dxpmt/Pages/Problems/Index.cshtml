@page
@model dxpmt.Pages.Problems.IndexModel
@{ ViewData["Title"]="問題・課題一覧"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F05</p><h1>問題・課題一覧</h1></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.CaseId">案件詳細</a><a class="btn btn-primary" asp-page="/Problems/Create" asp-route-caseId="@Model.CaseId">問題を追加</a></div></div>
<form method="get" class="mb-3"><input type="hidden" name="CaseId" value="@Model.CaseId"/><label class="form-check-label"><input asp-for="IncludeDeleted" class="form-check-input" onchange="this.form.submit()"/> 削除済みを表示</label></form>
<div class="panel p-0 overflow-hidden">@if(!Model.Items.Any()){<p class="empty-state m-0">問題はまだ登録されていません。</p>}else{<div class="table-responsive"><table class="table app-table mb-0"><thead><tr><th>No.</th><th>対象作業</th><th>分類</th><th>現象・事実</th><th>影響</th><th>重要度</th><th>状態</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr class="@(x.IsDeleted ? "table-secondary" : "")"><td>@x.Sequence</td><td>@(x.WorkItem?.Name??"未紐付け")</td><td>@x.Category</td><td class="pre-wrap">@x.Phenomenon @(x.IsDeleted ? "（削除済み）" : "")</td><td class="pre-wrap">@x.Impact</td><td>@x.Severity</td><td>@x.Status</td><td>@if(x.IsDeleted){<form method="post" asp-page-handler="Restore"><input type="hidden" name="CaseId" value="@Model.CaseId"/><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-outline-success btn-sm">復旧</button></form>}else{<form method="post" asp-page-handler="Delete"><input type="hidden" name="CaseId" value="@Model.CaseId"/><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-outline-danger btn-sm">削除</button></form>}</td></tr>}</tbody></table></div>}</div>
