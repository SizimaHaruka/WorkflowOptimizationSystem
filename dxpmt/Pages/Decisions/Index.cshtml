@page
@model dxpmt.Pages.Decisions.IndexModel
@{
    ViewData["Title"] = "意思決定記録";
}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F11</p><h1>意思決定記録</h1><p class="text-muted mb-0">@Model.Case.Title</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.Case.Id">案件詳細</a><a class="btn btn-primary" asp-page="/Decisions/Create" asp-route-caseId="@Model.Case.Id">意思決定を追加</a></div></div>
@if (Model.Records.Count == 0)
{
    <div class="panel"><p class="empty-state">意思決定記録はありません。</p></div>
}
else
{
    <div class="accordion" id="decisionAccordion">
    @foreach (var item in Model.Records)
    {
        var headingId = $"heading{item.Id}";
        var collapseId = $"collapse{item.Id}";
        <div class="accordion-item"><h2 class="accordion-header" id="@headingId"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId"><span class="me-3">D@item.Sequence.ToString("D3")</span>@item.Title <span class="ms-auto me-3 small text-muted">@item.DecidedOn.ToString("yyyy/MM/dd") / @item.DeciderName</span></button></h2><div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#decisionAccordion"><div class="accordion-body"><dl class="definition-list"><div><dt>決定事項</dt><dd class="pre-wrap">@item.Decision</dd></div><div><dt>対象範囲</dt><dd class="pre-wrap">@item.Scope</dd></div><div><dt>条件・制約</dt><dd class="pre-wrap">@item.Constraints</dd></div><div><dt>背景・問題</dt><dd class="pre-wrap">@item.BackgroundAndProblem</dd></div><div><dt>検討した選択肢</dt><dd class="pre-wrap">@item.Alternatives</dd></div><div><dt>採用理由</dt><dd class="pre-wrap">@item.ReasonForDecision</dd></div><div><dt>影響と追加対応</dt><dd class="pre-wrap">@item.Impact @item.FollowUpActions</dd></div></dl></div></div></div>
    }
    </div>
}
