@page
@model dxpmt.Pages.Decisions.CreateModel
@{
    ViewData["Title"] = "意思決定を追加";
}
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F11</p><h1>意思決定を追加</h1><p class="text-muted mb-0">重要な判断、範囲変更、要求変更は理由と影響を残します。</p></div><a class="btn btn-outline-secondary" asp-page="/Decisions/Index" asp-route-caseId="@Model.Case.Id">一覧へ戻る</a></div>
<form method="post" class="form-card"><input type="hidden" name="caseId" value="@Model.Case.Id" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <section class="form-section"><h2>基本情報</h2><div class="row g-3"><div class="col-md-4"><label class="form-label">案件番号</label><input class="form-control" value="@Model.Case.CaseNumber" disabled /></div><div class="col-md-4"><label asp-for="Input.DecidedOn" class="form-label"></label><input asp-for="Input.DecidedOn" class="form-control" type="date" /></div><div class="col-md-4"><label asp-for="Input.DeciderName" class="form-label"></label><input asp-for="Input.DeciderName" class="form-control" /><span asp-validation-for="Input.DeciderName" class="text-danger"></span></div><div class="col-md-8"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.Participants" class="form-label"></label><input asp-for="Input.Participants" class="form-control" /></div></div></section>
    <section class="form-section"><h2>決定内容</h2><div class="row g-3"><div class="col-12"><label asp-for="Input.Decision" class="form-label"></label><textarea asp-for="Input.Decision" class="form-control" rows="3"></textarea><span asp-validation-for="Input.Decision" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.Scope" class="form-label"></label><textarea asp-for="Input.Scope" class="form-control" rows="3"></textarea></div><div class="col-md-3"><label asp-for="Input.EffectiveOn" class="form-label"></label><input asp-for="Input.EffectiveOn" class="form-control" type="date" /></div><div class="col-md-3"><label asp-for="Input.Constraints" class="form-label"></label><textarea asp-for="Input.Constraints" class="form-control" rows="3"></textarea></div></div></section>
    <section class="form-section"><h2>判断根拠</h2><div class="row g-3"><div class="col-md-6"><label asp-for="Input.BackgroundAndProblem" class="form-label"></label><textarea asp-for="Input.BackgroundAndProblem" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.Alternatives" class="form-label"></label><textarea asp-for="Input.Alternatives" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.ReasonForDecision" class="form-label"></label><textarea asp-for="Input.ReasonForDecision" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.RejectedAlternatives" class="form-label"></label><textarea asp-for="Input.RejectedAlternatives" class="form-control" rows="3"></textarea></div><div class="col-12"><label asp-for="Input.References" class="form-label"></label><textarea asp-for="Input.References" class="form-control" rows="2"></textarea></div></div></section>
    <section class="form-section"><h2>影響と後続対応</h2><div class="row g-3"><div class="col-md-6"><label asp-for="Input.Impact" class="form-label"></label><textarea asp-for="Input.Impact" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.FollowUpActions" class="form-label"></label><textarea asp-for="Input.FollowUpActions" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label asp-for="Input.OwnerName" class="form-label"></label><input asp-for="Input.OwnerName" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.DueDate" class="form-label"></label><input asp-for="Input.DueDate" class="form-control" type="date" /></div><div class="col-md-4"><label asp-for="Input.ReviewCondition" class="form-label"></label><input asp-for="Input.ReviewCondition" class="form-control" /></div></div></section>
    <section class="form-section"><h2>承認</h2><div class="row g-3"><div class="col-md-4"><label asp-for="Input.CreatedBy" class="form-label"></label><input asp-for="Input.CreatedBy" class="form-control" readonly /><div class="form-text">ログインユーザーを自動記録します。</div></div><div class="col-md-4"><label asp-for="Input.ConfirmedBy" class="form-label"></label><input asp-for="Input.ConfirmedBy" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.ApprovedBy" class="form-label"></label><input asp-for="Input.ApprovedBy" class="form-control" readonly /><div class="form-text">ログインユーザーを自動記録します。</div></div></div></section>
    <div class="form-actions"><a class="btn btn-outline-secondary" asp-page="/Decisions/Index" asp-route-caseId="@Model.Case.Id">キャンセル</a><button class="btn btn-primary" type="submit">意思決定を記録</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
