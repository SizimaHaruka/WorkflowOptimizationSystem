@page
@model dxpmt.Pages.WorkItems.IndexModel
@{ ViewData["Title"] = "As-Is 作業一覧"; }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">@Model.Case.CaseNumber / F03</p><h1>As-Is 作業一覧</h1><p class="text-muted mb-0">1作業につき1票として、実態を記録します。</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Cases/Details" asp-route-id="@Model.CaseId">案件詳細</a><a class="btn btn-primary" asp-page="/WorkItems/Create" asp-route-caseId="@Model.CaseId">作業を追加</a></div></div>
<form method="get" class="mb-3"><input type="hidden" name="CaseId" value="@Model.CaseId" /><label class="form-check-label"><input asp-for="IncludeDeleted" class="form-check-input" onchange="this.form.submit()" /> 削除済みを表示</label></form>
<div class="panel p-0 overflow-hidden">@if (!Model.Items.Any()) { <p class="empty-state m-0">作業はまだ登録されていません。</p> } else { <div class="table-responsive"><table class="table app-table mb-0"><thead><tr><th>No.</th><th>業務・工程</th><th>作業名</th><th>担当部署・役割</th><th>確認</th><th>問題</th><th></th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr class="@(item.IsDeleted ? "table-secondary" : "")"><td>@item.Sequence</td><td>@item.BusinessProcessName</td><td>@item.Name @(item.IsDeleted ? "（削除済み）" : "")</td><td>@item.DepartmentAndRole</td><td>@(item.IsConfirmed ? "済" : "未")</td><td>@item.Problems.Count 件</td><td class="text-nowrap">@if (item.IsDeleted) { <form method="post" asp-page-handler="Restore" class="d-inline"><input type="hidden" name="CaseId" value="@Model.CaseId"/><input type="hidden" name="IncludeDeleted" value="true"/><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-outline-success btn-sm">復旧</button></form> } else { <a class="btn btn-outline-primary btn-sm" asp-page="/WorkItems/Edit" asp-route-id="@item.Id">修正</a><form method="post" asp-page-handler="Delete" class="d-inline"><input type="hidden" name="CaseId" value="@Model.CaseId"/><input type="hidden" name="IncludeDeleted" value="@Model.IncludeDeleted"/><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-outline-danger btn-sm" onclick="return confirm('この作業を削除しますか？')">削除</button></form> }</td></tr> }</tbody></table></div> }</div>
