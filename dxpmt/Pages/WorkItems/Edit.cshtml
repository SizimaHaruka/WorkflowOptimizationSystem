@page
@model dxpmt.Pages.WorkItems.EditModel
@{ ViewData["Title"] = "F03 作業ヒアリング票を修正"; }
<div class="page-heading mb-4"><p class="eyebrow">F03-@Model.Item.Sequence</p><h1>作業ヒアリング票を修正</h1></div>
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Input.BusinessProcessName" class="form-label"></label><input asp-for="Input.BusinessProcessName" class="form-control"/></div><div class="col-md-6"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control"/><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.DepartmentAndRole" class="form-label"></label><input asp-for="Input.DepartmentAndRole" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.Performer" class="form-label"></label><input asp-for="Input.Performer" class="form-control"/></div><div class="col-md-4"><label asp-for="Input.Location" class="form-label"></label><input asp-for="Input.Location" class="form-control"/></div><div class="col-12"><label asp-for="Input.Content.ActualSteps" class="form-label">実際の作業手順</label><textarea asp-for="Input.Content.ActualSteps" class="form-control" rows="5"></textarea></div><div class="col-md-6"><label asp-for="Input.Content.CurrentProblems" class="form-label">問題と現在の回避方法</label><textarea asp-for="Input.Content.CurrentProblems" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="Input.Content.UnconfirmedItems" class="form-label">未確認事項</label><textarea asp-for="Input.Content.UnconfirmedItems" class="form-control" rows="3"></textarea></div><div class="col-12 form-check"><input asp-for="Input.IsConfirmed" class="form-check-input"/><label asp-for="Input.IsConfirmed" class="form-check-label"></label></div></div><div class="form-actions"><a class="btn btn-outline-secondary" asp-page="/WorkItems/Index" asp-route-caseId="@Model.Item.CaseId">キャンセル</a><button class="btn btn-primary">更新</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
